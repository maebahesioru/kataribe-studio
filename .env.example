# Kataribe Studio — environment template.
# Copy to .env and fill in.  All inference can run on any OpenAI-compatible endpoint.
#
# === AMD (primary) — key from https://notebooks.amd.com/tokenfactory ===
AMD_BASE_URL=https://your-amd-token-factory-endpoint.example/v1
AMD_API_KEY=
AMD_MODEL=Qwen3-32B
# === Fallback (local dev / offline demo) ===
FALLBACK_BASE_URL=http://127.0.0.1:8790/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gemini-3.8-flash
# Which provider the server starts with: amd | fallback
LLM_PROVIDER=fallback
# Server
PORT=7866
